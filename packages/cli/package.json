{
  "name": "@spctre/cli",
  "version": "0.3.2",
  "description": "Control plane CLI for governed agent systems",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getspctre/spctre/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
