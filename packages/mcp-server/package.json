{
  "name": "@spctre/mcp-server",
  "version": "0.1.2",
  "description": "MCP server for Spctre policy governance",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getspctre/spctre/tree/main/packages/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getspctre/spctre.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/getspctre/spctre/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spctre-mcp-server": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc && chmod +x dist/index.js",
    "test": "vitest run",
    "dev": "tsc -w",
    "start": "node dist/index.js",
    "start:http": "SPCTRE_MCP_TRANSPORT=http node dist/index.js",
    "example": "node dist/example.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "ajv": "^8.20.0",
    "axios": "^1.18.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
