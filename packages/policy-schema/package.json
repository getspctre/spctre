{
  "name": "@spctre/policy-schema",
  "version": "0.8.0",
  "description": "Shared types and logic for governed agent systems",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getspctre/spctre/tree/main/packages/policy-schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getspctre/spctre.git",
    "directory": "packages/policy-schema"
  },
  "bugs": {
    "url": "https://github.com/getspctre/spctre/issues"
  },
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./packs": {
      "types": "./src/packs.ts",
      "require": "./dist/packs.js",
      "import": "./dist/packs.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "require": "./dist/types.js",
      "import": "./dist/types.js"
    },
    "./wasm": {
      "types": "./src/wasm.ts",
      "require": "./dist/wasm.js",
      "import": "./dist/wasm.js"
    },
    "./wasm-node": {
      "types": "./src/wasm-node.ts",
      "require": "./dist/wasm-node.js",
      "import": "./dist/wasm-node.js"
    }
  },
  "files": [
    "NOTICE",
    "dist",
    "native/*.node",
    "native/*.wasm",
    "native/index.d.ts",
    "native/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "require": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./packs": {
        "types": "./dist/packs.d.ts",
        "require": "./dist/packs.js",
        "import": "./dist/packs.js"
      },
      "./types": {
        "types": "./dist/types.d.ts",
        "require": "./dist/types.js",
        "import": "./dist/types.js"
      },
      "./wasm": {
        "types": "./dist/wasm.d.ts",
        "require": "./dist/wasm.js",
        "import": "./dist/wasm.js"
      },
      "./wasm-node": {
        "types": "./dist/wasm-node.d.ts",
        "require": "./dist/wasm-node.js",
        "import": "./dist/wasm-node.js"
      }
    }
  },
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "prebuild": "pnpm build:native",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json -w",
    "test": "vitest run",
    "test:vendor-sdk-matrix": "vitest run tests/vendor-sdk-compatibility.test.ts"
  },
  "dependencies": {
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "ai": "7.0.66",
    "genkit": "1.39.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
