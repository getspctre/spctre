{
  "name": "@spctre/sdk",
  "version": "0.4.2",
  "description": "Official TypeScript SDK for the Spctre API",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getspctre/spctre/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getspctre/spctre.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/getspctre/spctre/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "openapi-typescript ../api-contracts/openapi.json -o src/schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
