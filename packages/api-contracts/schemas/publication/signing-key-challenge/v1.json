{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.spctre.dev/publication/signing-key-challenge/v1.json",
  "title": "Publication Signing Key Challenge Request",
  "description": "Body accepted when requesting an enrollment challenge for a signing key.",
  "type": "object",
  "properties": {
    "entityRef": {
      "type": "string",
      "pattern": "^entity:[A-Za-z0-9._:-]+$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "entityRef",
    "keyId",
    "publicKey"
  ]
}
