{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.spctre.dev/publication/signing-key-enroll/v1.json",
  "title": "Publication Signing Key Enrollment Request",
  "description": "Body accepted when enrolling a signing key against an issued challenge.",
  "type": "object",
  "properties": {
    "entityRef": {
      "type": "string",
      "pattern": "^entity:[A-Za-z0-9._:-]+$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "challengeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "replacesKeyId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "proof": {
      "type": "object",
      "properties": {
        "payload": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "spctre.publication-signing-challenge.v1"
            },
            "challengeId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "challenge": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "schema",
            "challengeId",
            "challenge"
          ]
        },
        "signature": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "Ed25519"
            },
            "keyId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "publicKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "payloadHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "algorithm",
            "keyId",
            "publicKey",
            "payloadHash",
            "value"
          ]
        }
      },
      "required": [
        "payload",
        "signature"
      ]
    }
  },
  "required": [
    "entityRef",
    "keyId",
    "publicKey",
    "challengeId",
    "proof"
  ]
}
