# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://spctre:spctre@localhost:5433/spctre
# DATABASE_POOL_SIZE=10

# ── App URL ───────────────────────────────────────────────────────────────────
# Public-facing origin used by magic-link generation, OAuth callbacks, and the
# magic-link handler when constructing redirect URLs. Set this in all deployments
# so auth redirects never depend on x-forwarded-host from the proxy.
# Used by: magic-link generation, Google/GitHub OAuth callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SPCTRE_APP_URL is a server-side-only override for the magic-link redirect base.
# Set it when NEXT_PUBLIC_APP_URL is exposed to the browser bundle but the
# server-side redirect origin should differ (e.g. internal vs. external hostname).
# If unset, the magic-link handler falls back to NEXT_PUBLIC_APP_URL, then to
# forwarded headers — which is only safe when the proxy sanitises x-forwarded-host.
# SPCTRE_APP_URL=

# ── Session / auth ────────────────────────────────────────────────────────────
# Secret used to sign the edge-level session guard JWT. Must be a long random string.
SPCTRE_SESSION_GUARD_SECRET=change-me-to-a-long-random-string
# Session duration in hours (default: 24)
# SPCTRE_SESSION_TTL_HOURS=24

# ── Service identity ──────────────────────────────────────────────────────────
# Bearer token required for POST /api/evidence (AGT runtime → Spctre ingest).
# SPCTRE_SERVICE_TOKEN=
SPCTRE_EVIDENCE_INGEST_URL=http://localhost:18080
SPCTRE_WORKER_INTERNAL_SECRET=local-dev-worker-internal-secret
GATEWAY_ENABLED=true
GATEWAY_MODE=HYBRID

# Optional: Ed25519 PKCS#8 private key for portable high-risk action receipts.
# Use a deployment secret; literal \n sequences are accepted for multiline PEMs.
# SPCTRE_RECEIPT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SPCTRE_RECEIPT_SIGNING_KEY_ID=spctre-action-receipt-v1

# ── Demo tenant / workspace overrides ────────────────────────────────────────
# Override the seeded demo tenant and workspace UUIDs if needed.
# SPCTRE_DEMO_TENANT_ID=
# SPCTRE_DEMO_WORKSPACE_ID=

# ── Billing webhooks ──────────────────────────────────────────────────────────
# Paddle notification destination secret for /api/billing/paddle/webhook.
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# ── OIDC / SSO ────────────────────────────────────────────────────────────────
# Set OIDC_ENABLED=true and fill in the remaining vars to show the SSO button
# on the login page and activate the /api/auth/oidc/authorize + callback routes.
# OIDC_ENABLED=true
# OIDC_PROVIDER_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_DEFAULT_TENANT_ID=

# ── SAML 2.0 SSO ─────────────────────────────────────────────────────────────
# Set SAML_ENABLED=true and configure the SP entity ID and ACS URL to activate
# the /api/auth/saml/authorize + callback routes. The IdP entry point URL and
# signing certificate are stored per-tenant via Admin → Authentication settings.
# Download SP metadata from /api/auth/saml/metadata and paste it into your IdP.
# SAML_ENABLED=true
# SAML_SP_ENTITY_ID=https://app.spctre.dev
# SAML_ACS_URL=https://app.spctre.dev/api/auth/saml/callback

# ── Passkeys (WebAuthn) ───────────────────────────────────────────────────────
# Relying party settings for passkey registration and authentication.
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=Spctre
