# Spctre environment variables — copy to .env and fill in values.
# All three deployable units (web, worker, mcp-server) share a single file for
# local development. In production, inject per-unit via your secrets manager.

# ── Database ──────────────────────────────────────────────────────────────────
# Required by: web, worker, migrate job
#
# RLS (Row-Level Security) architecture:
#   The web app should connect as the spctre_app role so RLS policies enforce
#   tenant isolation at the database level. Migrations and the Go worker use
#   the owner role (which bypasses RLS) for cross-tenant background jobs.
#
#   Production example:
#     DATABASE_URL=postgresql://spctre_app:<password>@host:5432/spctre
#     DATABASE_OWNER_URL=postgresql://spctre:<password>@host:5432/spctre
#
#   Local development (both use the owner role by default; the migration
#   auto-creates the spctre_app role):
DATABASE_URL=postgres://spctre:spctre@localhost:5433/spctre
# Optional owner connection for narrowly audited bypass flows such as global
# service-token lookup before tenant context is known. Required when DATABASE_URL
# uses the RLS-constrained spctre_app role.
# DATABASE_OWNER_URL=postgres://spctre:spctre@localhost:5433/spctre
# Used by migrations when creating the spctre_app role. Required in production.
# SPCTRE_APP_DB_PASSWORD=

# ── Web control plane ─────────────────────────────────────────────────────────
# Required by: web
SPCTRE_SESSION_GUARD_SECRET=change-me-in-production
SPCTRE_SESSION_TTL_HOURS=24
# Required for alerting integrations and SIEM event streaming. Passphrase used
# by pgp_sym_encrypt / pgp_sym_decrypt to encrypt alerting_integration credentials
# (routing keys, tokens, webhook secrets) and workspace_siem_stream secrets at rest.
# SPCTRE_CREDENTIAL_ENCRYPTION_KEY=

# Optional: Ed25519 PKCS#8 private key for portable high-risk action receipts.
# Use a deployment secret; literal \n sequences are accepted for multiline PEMs.
# SPCTRE_RECEIPT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SPCTRE_RECEIPT_SIGNING_KEY_ID=spctre-action-receipt-v1

# Optional: Global rate limiting (Commercial only). Provide an Upstash Redis REST
# endpoint. If omitted, the app falls back to a per-instance in-memory limiter:
# fine for single-instance/dev, but on multi-instance deployments (Cloud Run)
# the effective global limit becomes N-instances x the configured limit and
# resets on every scale event. Bind Upstash for a real global ceiling.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: override seed tenant / workspace IDs used in dev/demo mode
# SPCTRE_DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
# SPCTRE_DEMO_WORKSPACE_ID=00000000-0000-0000-0000-000000000002

# Optional: Paddle billing lifecycle webhook signing secret.
# Required to enable POST /api/billing/paddle/webhook.
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# ── Feature flags (web) ───────────────────────────────────────────────────────
SPCTRE_PLAN=oss
GATEWAY_ENABLED=false
GATEWAY_MODE=HYBRID
LOCAL_SIGNUP_ENABLED=true
OIDC_ENABLED=false
SAML_ENABLED=false

# ── Passkey (web) ─────────────────────────────────────────────────────────────
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME="Spctre Control Plane"

# ── Social login (§33) ────────────────────────────────────────────────────────
# Google OAuth2 — create at console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth2 — create at github.com → Settings → Developer settings → OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Magic-link email (§33) ──────────────────────────────────────────────────────
# Resend (https://resend.com) — leave blank to log links to console in dev.
# RESEND_API_KEY=
# MAGIC_LINK_FROM_EMAIL=noreply@example.com

# Public app URL — used to build magic links and OAuth redirect URIs.
# Required in production. In local dev defaults to http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Worker ────────────────────────────────────────────────────────────────────
# Required by: worker
WORKER_HTTP_PORT=18080

# ── MCP server ────────────────────────────────────────────────────────────────
# Required by: mcp-server
SPCTRE_MCP_TRANSPORT=stdio          # stdio | http
SPCTRE_MCP_HTTP_PORT=3100
SPCTRE_MCP_HTTP_SSE_PATH=/sse
SPCTRE_MCP_HTTP_MESSAGE_PATH=/message
SPCTRE_MCP_REQUIRE_BEARER_AUTH=true

SPCTRE_API_URL=http://localhost:3000
SPCTRE_WORKSPACE_ID=                # required: workspace to scope MCP calls
SPCTRE_AGENT_ID=mcp-server

# One of the following is required for the MCP server to authenticate:
SPCTRE_API_TOKEN=
SPCTRE_API_REFRESH_TOKEN=

# Optional allowlists (comma-separated). Empty = allow all.
SPCTRE_ALLOWED_TOOLS=
SPCTRE_ALLOWED_CONNECTORS=
